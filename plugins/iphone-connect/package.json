{
  "name": "@igentic/iphone-connect",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local iPhone diagnostics plugin for ChatGPT and MCP clients",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "test": "node --test test/*.test.mjs",
    "doctor": "node scripts/doctor.mjs",
    "control": "node scripts/control-center.mjs",
    "build:ui": "node scripts/build-ui.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:usb": "node scripts/smoke-native-transport.mjs --usb",
    "smoke:wifi": "node scripts/smoke-native-transport.mjs --wifi",
    "package": "node scripts/package.mjs",
    "serve:portable": "node src/portable-gateway.mjs",
    "serve:cellular": "node src/cellular-gateway.mjs",
    "smoke:handoff:wifi": "node scripts/smoke-handoff-wifi.mjs",
    "smoke:published:wifi": "node scripts/smoke-published-handoff-wifi.mjs",
    "smoke:cellular-host": "node scripts/smoke-cellular-host.mjs",
    "preflight:cellular-physical": "node scripts/physical-cellular-preflight.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "2.0.4",
    "@modelcontextprotocol/sdk": "1.32.2",
    "jose": "6.2.18",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.65.1"
  }
}
